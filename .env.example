# Gemini API Keys
# The platform automatically provides GEMINI_API_KEY for the free tier.
# Users can select a paid key which will be available as API_KEY.
GEMINI_API_KEY=
API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Hugging Face Inference Providers (open-source models)
# Fine-grained token with "Make calls to Inference Providers": https://huggingface.co/settings/tokens
# Optional: users can also paste their own token in the app Settings.
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b
