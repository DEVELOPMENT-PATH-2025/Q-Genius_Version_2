# Development Environment Variables (NOT for production)
# Add your Gemini API key here for local testing only
# DO NOT commit this file to version control

# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Example: GEMINI_API_KEY=AIzaSy...

# Hugging Face Inference Providers (open-source models)
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b

# Other development keys (optional)
API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:5173
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
